# Unreal Engine 5 - Roman Empire Game .gitignore

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# VS Code project metadata generated by UnrealBuildTool
.vscode/
*.code-workspace
compileCommands*.json

# Unreal Engine generated state
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Artifacts/
Tools/Reports/*
!Tools/Reports/.gitkeep

# Source assets under Content are intentionally tracked through Git LFS.
# Never add *.uasset or *.umap ignore rules here.

# Platform-specific
*.pdb
*.lib
*.dll
*.exe

# Mac
.DS_Store
*.xcworkspace
*.xcuserdata

# Linux
*.o
*.so

# JetBrains IDEs
.idea/

# Backup files
*~
*.bak
*.swp

# Generated files
*.sln
*.generated.h
*.generated.cpp

# Package files
*.pak

# Logs
*.log
Logs/

# Crash reports
CrashReportClient/

# Hot reload
/Plugins/*/Intermediate/

# Automation
/Automation/

# API keys and secrets
.env
Tools/.env

# Note: We ARE including .uproject, Config/, Source/, and Content/Scripts
# These are the core project files that should be version controlled
